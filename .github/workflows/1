



name: Build and Test (Microservices)

on:
  push:
    branches: [ "app/*" ]
  pull_request:
    branches: [ "dev" ]

jobs:
  build:
    runs-on: ubuntu-latest

    services:
      postgres:
        image: postgres:14-alpine
        env:
          POSTGRES_DB: micro-banking-db
          POSTGRES_USER: testuser
          POSTGRES_PASSWORD: testpass
        ports:
          - 5432:5432
        options: >-
          --health-cmd="pg_isready -U testuser -d micro-banking-db"
          --health-interval=10s
          --health-timeout=5s
          --health-retries=5

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: maven

      - name: Build and test nickname-service
        working-directory: ./app/nickname-service
        run: |
          mvn clean package -DskipTests=false

      - name: Build and test gateway-service
        working-directory: ./app/gateway-service
        run: |
          mvn clean package -DskipTests=false

      - name: Build Docker images
        run: |
          docker compose -f app/docker-compose.yml build

      - name: List built images
        run: docker images

